{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/danglio",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/dangle",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/refund",
      "destination": "/refunds",
      "permanent": true
    },
    {
      "source": "/shipping",
      "destination": "/delivery",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/danglio-api/storage/v1/object/public/danglio-packs/:path*",
      "destination": "https://kvjcskqynhprbvhnslph.supabase.co/storage/v1/object/public/danglio-packs/:path*"
    },
    {
      "source": "/danglio-api/functions/v1/:path*",
      "destination": "https://kvjcskqynhprbvhnslph.supabase.co/functions/v1/:path*"
    },
    {
      "source": "/download/mac",
      "destination": "https://kvjcskqynhprbvhnslph.supabase.co/storage/v1/object/public/downloads/mac/Danglio.dmg"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/download/mac",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Danglio.dmg\""
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ]
}
