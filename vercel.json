{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/danglio",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/dangle",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/refund",
      "destination": "/refunds",
      "permanent": true
    },
    {
      "source": "/shipping",
      "destination": "/delivery",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
